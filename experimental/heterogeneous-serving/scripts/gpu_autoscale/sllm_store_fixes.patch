-      ssize_t ret =
-          pwrite(fd_, direct_write_buf, direct_write_size, file_offset_);
-      if (ret < 0 || ret != direct_write_size) {
+      // pwrite moves at most 0x7ffff000 bytes per call on Linux: a tensor larger
+      // than 2 GiB written here needs several calls
+      ssize_t ret = 0;
+      size_t done = 0;
+      while (done < direct_write_size) {
+        ret = pwrite(fd_, (char*)direct_write_buf + done,
+                     direct_write_size - done, file_offset_ + done);
+        if (ret <= 0) break;
+        done += ret;
+      }
+      if (done != direct_write_size) {
         std::cerr << "Failed to write to file, ret: " << ret
                   << " errno: " << errno << std::endl;
         return written;
