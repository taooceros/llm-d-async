+# Every tensor starts on a 256-byte boundary of the device allocation, as with cudaMalloc and PyTorch's caching
+# allocator. Packing the records back to back left half of Gemma-4's tensors only 8-byte aligned, and kernels
+# that assume 16-byte alignment (Inductor's, cuBLAS's) then take slow paths: CUDA graph capture 24 s instead
+# of 8 s and 1.2 GiB more graph memory (vLLM 0.23, H100, 2026-10-29).
+DEVICE_ALIGNMENT = 256
+
+
+def _aligned(size):
+    return (size + DEVICE_ALIGNMENT - 1) // DEVICE_ALIGNMENT * DEVICE_ALIGNMENT
+
+
 def calculate_device_memory(device_map, tensor_index):
     device_memory = {}
     tensor_record = {}
@@ -80,7 +91,7 @@ def calculate_device_memory(device_map, tensor_index):
